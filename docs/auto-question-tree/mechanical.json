        "clutch": "mechanical.result.clutch",
        "drive": "mechanical.result.drive",
        "exhaust": "mechanical.result.exhaust"
      }
    },
    {
      "observed": "Указан Common Rail, наддув, DPF/GPF, SCR/AdBlue как направление проверки",
      "target": "mechanical.result.general",
      "requirements": "Добавить явно названную систему к компетенциям диагноста; не выбирать замену из комбинированного названия услуги."
