  "entry_rules": [
    {
      "observed": "Шум или вибрация с неизвестным источником",
      "target": "mechanical.result.noise",
      "note": "Если шум/вибрация не заявлены, неизвестная жалоба остаётся общей проверкой."
    },
    {
      "observed": "Не заводится / потеря тяги / заглох / троит / после заправки стало плохо",
      "target": "mechanical.result.engine",
      "note": "Не различать стартер/обороты ради назначения детали; сообщённое вращение стартера сохранить."
    },
    {
      "observed": "После воды пропала тяга/заглох",
      "target": "mechanical.result.engine",
      "note": "Сохранить воду как событие, предусмотреть проверку электрики; mechanical.present только если нужна логистика. Не назначать ремонт последствий воды как доказанный."
    },
    {
